# ---------- HTTP ----------
HTTP_ADDR=127.0.0.1:8321
APP_BASE_URL=http://127.0.0.1:8321

# ---------- 前端（前后端分离 + 同源代理） ----------
# 前端站点地址：登录成功/失败、退出后的跳转目标
# 开发态是 Vite dev server；生产与 API 同域，例如 https://agent.example.com
WEB_BASE_URL=http://127.0.0.1:5173

# ---------- 数据库 ----------
# docker compose up -d postgres 之后可直接用
DATABASE_URL=postgres://autoagent:autoagent@127.0.0.1:5432/autoagent?sslmode=disable

# ---------- 身份接入（技术方案 §5.1.1 IdentityProvider） ----------
# dingtalk = 已实现；wecom / feishu = 占位（登录返回 501，服务仍可启动）
IDENTITY_PROVIDER=dingtalk

# 钉钉开发者后台 → 企业内部应用 → 凭证与基础信息（新版叫 Client ID / Client Secret）
# 扫码登录与通讯录接口共用这组凭证；通讯录权限缺失时工号/邮箱为空，登录仍可用
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
# 企业名称兜底（可选）：未开通 Contact.Org.Read 时顶栏显示它
DINGTALK_CORP_NAME=

# 需要在钉钉开放平台为应用开通的权限：
#   qyapi_get_member  通讯录成员信息读 → 工号、邮箱
#   Contact.Org.Read  通讯录组织基础信息读 → 企业名称

# 必须与开发者后台「登录与分享 → 回调域名 / 重定向 URL」完全一致（含协议、端口、路径、末尾斜杠）
# 中立地址 /auth/callback 与旧地址 /auth/dingtalk/callback 均可
DINGTALK_REDIRECT_URI=http://127.0.0.1:8321/auth/callback

# 企业微信 / 飞书（实现后再启用，当前不读取）
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_SECRET=
# WECOM_REDIRECT_URI=
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_REDIRECT_URI=

# ---------- 会话 ----------
SESSION_COOKIE=aa_session
SESSION_TTL=168h
# 本地是 http，必须为 false；生产 https 改 true
COOKIE_SECURE=false

# ---------- 存储（MVP 本地 FS） ----------
STORAGE_ROOT=./data/storage

# ---------- 模型（Provider 适配层 + ModelRouter，技术方案 §5.7.1） ----------
# openai = OpenAI 兼容协议（DeepSeek / 通义兼容模式 / vLLM / Ollama）；anthropic = 原生 Messages 协议
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 单次模型调用超时。流式请求是整请求超时，必须 ≥ LLM_MAX_WALL_CLOCK，否则长回答会被上游先掐断
LLM_TIMEOUT=10m
LLM_MAX_TOKENS=4096
# 轮次 = 一次模型调用。多步任务（检索 → 读正文 → 写文件）在 5 轮内经常差一步，默认 8；
# 真正的上限由墙钟、工具次数与累计 token 三道预算兜住。
LLM_MAX_ROUNDS=8
# 一次 run 的预算：工具调用次数、并行度、墙钟上限、累计 token（0 = 不限）
LLM_MAX_TOOL_CALLS=20
LLM_MAX_PARALLEL=4
LLM_MAX_WALL_CLOCK=10m
LLM_MAX_TOTAL_TOKENS=80000
# 历史摘要用小模型，留空复用主模型
LLM_SUMMARY_MODEL=

# 主备降级（可选）：仅同协议族可降级，已产出流后不再切换
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# 向量模型（可选）：配置后开启历史消息语义检索，未配置则只用摘要 + 滑动窗口
LLM_EMBED_BASE_URL=
LLM_EMBED_API_KEY=
LLM_EMBED_MODEL=

# ---------- Agent 运行时（编排实现切换，技术方案 §5.7.7） ----------
# builtin = 内置 ReAct（模型 → 工具 → 模型，默认）；direct = 无工具单轮直答（更快更省 token）
# 未注册的名字会在启动时告警并回退 builtin
AGENT_IMPL=builtin
# 派生子 Agent：是否暴露 agent_dispatch、最多派发几层、连续几轮无新信息判定停滞
AGENT_DISPATCH=true
AGENT_MAX_DEPTH=2
AGENT_STALL_ROUNDS=2

# ---------- 命令执行沙箱（internal/sandbox） ----------
# true = 必须有真实隔离后端（Linux: bwrap / macOS: sandbox-exec），探测不到就启动失败。
# 生产环境请置 true；开发机可保持 false，降级到 local（无隔离）时启动日志会告警。
SANDBOX_REQUIRE=false
# 沙箱是白名单挂载：没列出的路径在沙箱里不存在。
# 运行时装在非标准位置时（npm 装的 deno 是 node 包装脚本、自建 node/python），
# 必须把安装前缀加进来，否则会报「Cannot find module」这类与权限无关的错。
# 逗号分隔的绝对路径，例如：SANDBOX_READ_EXTRA=/opt/deno,/usr/local/lib/node_modules
SANDBOX_READ_EXTRA=

# ---------- 插件常驻进程 ----------
# 每个插件一个子进程，调用之间复用。空闲多久回收（秒），默认 600。
PLUGIN_PROC_IDLE_SECONDS=600
# 同时存在的常驻进程上限，超出时回收最久未用的。默认 32。
PLUGIN_PROC_MAX=32

# ---------- 凭证加密（技术方案 §5.5.2 的 MVP 形态） ----------
# 信封加密的 KEK：包裹每条凭证自己的 DEK。只从环境变量读，绝不能提交进仓库。
# 为空时凭证存储不可用，需要密钥的能力（web_search）自动降级为「未配置」。
# 更换 KEK 会导致已存凭证无法解密，需要重新录入。
SECRET_KEK=

# ---------- 插件发布扫描（docs/插件安全基线.md） ----------
# 规则目录：<dir>/active.json 指向 <dir>/<version>/rules.json；为空则只用内置规则。
# 改规则后无需重启：每次发布前比对一次文件指纹，变化即热加载；
# 规则写坏时保留旧规则，不影响发布。
SCAN_RULES_DIR=
# 依赖漏洞数据源：local = 本地 OSV 镜像（私有化推荐）；remote = api.osv.dev；off = 关闭。
# 扫描不可用时报告状态为 unscanned，不阻断发布。
SCAN_OSV_MODE=local
# 本地漏洞库目录（OSV 官方 JSON）；为空时用 {STORAGE_ROOT}/osv
SCAN_OSV_DIR=
# 误报豁免（逗号分隔规则 id）：只影响阻断，命中仍会记录
SCAN_ALLOW_RULES=

# ---------- 通用搜索（技术方案 §5.6.1 search.query） ----------
# provider：bocha；endpoint 与白名单属于平台属性，skill / 模型都无法指定
SEARCH_PROVIDER=bocha
SEARCH_ENDPOINT=https://api.bochaai.com/v1/web-search
# 出网白名单（逗号分隔域名）：只允许 https、域名边界匹配、拒绝内网 IP、不跟随 30x
SEARCH_ALLOW=api.bochaai.com
# 仅用于首次播种到凭证存储（{STORAGE_ROOT}/secrets/），之后请清空这里、以凭证存储为准。
# 或者：在系统空间 files/config.json 里把 search.secret 写成 "${SEARCH_API_KEY}"，
# 先查凭证存储同名条目，没有再读这个环境变量（适合 k8s Secret / systemd 注入，
# 也不需要 SECRET_KEK）；之后在「密钥配置」里新增同名凭证即可覆盖它。
SEARCH_API_KEY=

# 系统管理员工号（逗号分隔）：只有这些用户可见并编辑「系统空间」
ADMIN_JOB_NUMBERS=

# ---------- 插件体系（docs/插件体系设计.md） ----------
# 新空间创建时安装哪些预置插件（逗号分隔 slug），例如：builtin_space,builtin_files,builtin_sessions
# 只影响之后新建的空间；已存在的空间不追溯。缺省为空 = 不预装。
PLUGIN_DEFAULT_INSTALL=
# false = 只有系统管理员能安装插件；true = 有 manage 权限的空间成员可自助安装
PLUGIN_ALLOW_USER_INSTALL=true
